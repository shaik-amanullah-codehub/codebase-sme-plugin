{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Helvetica, Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#eef2ff",
    "primaryBorderColor": "#4338ca",
    "primaryTextColor": "#1e1b4b",
    "lineColor": "#64748b",
    "secondaryColor": "#f1f5f9",
    "tertiaryColor": "#ffffff",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#cbd5e1",
    "edgeLabelBackground": "#ffffff"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 20,
    "nodeSpacing": 50,
    "rankSpacing": 60
  },
  "sequence": {
    "actorMargin": 60,
    "messageAlign": "center",
    "wrap": true,
    "boxMargin": 10
  }
}
